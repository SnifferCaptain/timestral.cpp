/*
 * @file attentionSubgroup.comp
 * @brief 带subgroup对齐检查与可移植回退的在线注意力
 */

#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 64, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer Queries { float values[]; } queries;
layout(set = 0, binding = 1, std430) readonly buffer Keys { float values[]; } keys;
layout(set = 0, binding = 2, std430) readonly buffer Values { float values[]; } vals;
layout(set = 0, binding = 3, std430) readonly buffer Metadata { float values[]; } meta;
layout(set = 0, binding = 4, std430) buffer Output { float values[]; } result;
layout(push_constant) uniform Parameters {
    uint rows;
    uint count;
    uint base;
    uint encoded;
    uint contextPatches;
    uint heads;
    uint headDim;
    uint covariates;
    uint isTime;
} p;

shared float tileQ[8][64];
shared float tileK[64][65];
shared float tileV[64][64];
shared float scores[8][64];
shared float reduction[8][64];
shared float subgroupValues[16];
shared uint subgroupRows[16];
shared uint subgroupInvalid;

bool timeAllowed(uint row, uint query, uint key) {
    uint role = uint(meta.values[p.rows * p.encoded + row]);
    if (query < p.encoded) {
        return key < p.encoded && (query == key || (meta.values[row * p.encoded + key] != 0.0
            && ((p.covariates != 0 && role == 2) || key <= query)));
    }
    if (key < p.encoded) {
        return (p.covariates == 0 || query - p.encoded >= p.contextPatches)
            && key < p.contextPatches && meta.values[row * p.encoded + key] != 0.0;
    }
    uint queryDec = query - p.encoded;
    uint keyDec = key - p.encoded;
    return query == key || (keyDec <= queryDec && (p.covariates == 0
        || (queryDec >= p.contextPatches && keyDec >= p.contextPatches)));
}

void main() {
    uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint queryBlocks = (p.count + 7) / 8;
    if (group >= p.rows * queryBlocks * p.heads) {
        return;
    }
    uint lane = gl_LocalInvocationID.x;
    uint localQuery = gl_LocalInvocationID.y;
    uint threadIndex = localQuery * 64 + lane;
    if (threadIndex == 0) {
        subgroupInvalid = 0;
    }
    barrier();
    bool aligned = subgroupAllEqual(localQuery);
    if (subgroupElect() && (!aligned || gl_NumSubgroups > 16 || (gl_SubgroupSize != 32 && gl_SubgroupSize != 64))) {
        atomicOr(subgroupInvalid, 1);
    }
    barrier();
    bool useSubgroups = subgroupInvalid == 0;
    uint head = group % p.heads;
    uint block = group / p.heads;
    uint row = block / queryBlocks;
    uint slot = (block % queryBlocks) * 8 + localQuery;
    bool validQuery = slot < p.count;
    uint keyCount = p.base + p.count;
    uint loopEnd = keyCount;
    uint lastQuery = p.base + min((block % queryBlocks) * 8 + 7, p.count - 1);
    uint role = uint(meta.values[p.rows * p.encoded + row]);
    // 仅跳过整块未来键，不改变实际K/V行步距与块内双流谓词
    if (lastQuery < p.encoded && (p.covariates == 0 || role != 2)) {
        loopEnd = min(keyCount, (lastQuery / 64 + 1) * 64);
    }
    uint dim = p.heads * p.headDim;
    uint outputOffset = (row * p.count + slot) * dim + head * p.headDim;
    tileQ[localQuery][lane] = validQuery ? queries.values[outputOffset + lane] : 0.0;
    precise float maximum = uintBitsToFloat(0xff800000u);
    precise float denominator = 0.0;
    precise float accumulator = 0.0;

    for (uint first = 0; first < loopEnd; first += 64) {
        // 全组合作加载，沿head维合并读取，八query复用同一K/V块
        for (uint index = threadIndex; index < 4096; index += 512) {
            uint localKey = index / 64;
            uint j = index % 64;
            uint selected = first + localKey;
            uint offset = (row * keyCount + selected) * dim + head * p.headDim + j;
            tileK[localKey][j] = selected < keyCount ? keys.values[offset] : 0.0;
            tileV[localKey][j] = selected < keyCount ? vals.values[offset] : 0.0;
        }
        barrier();
        uint key = first + lane;
        bool allowed = validQuery && key < keyCount && timeAllowed(row, p.base + slot, key);
        precise float score = uintBitsToFloat(0xff800000u);
        if (allowed) {
            precise float sum = 0.0;
            for (uint j = 0; j < 64; ++j) {
                precise float product = tileQ[localQuery][j] * tileK[lane][j];
                sum = sum + product;
            }
            precise float factor = 1.0 / sqrt(float(p.headDim));
            score = sum * factor;
        }
        precise float blockMaximum = uintBitsToFloat(0xff800000u);
        if (useSubgroups && gl_SubgroupSize == 64) {
            blockMaximum = subgroupMax(score);
        } else if (useSubgroups) {
            precise float maximumPart = subgroupMax(score);
            if (subgroupElect()) {
                subgroupRows[gl_SubgroupID] = localQuery;
                subgroupValues[gl_SubgroupID] = maximumPart;
            }
            barrier();
            for (uint groupIndex = 0; groupIndex < gl_NumSubgroups; ++groupIndex) {
                if (subgroupRows[groupIndex] == localQuery) {
                    blockMaximum = max(blockMaximum, subgroupValues[groupIndex]);
                }
            }
        } else {
            reduction[localQuery][lane] = score;
            barrier();
            for (uint stride = 32; stride > 0; stride >>= 1) {
                if (lane < stride) {
                    reduction[localQuery][lane] = max(reduction[localQuery][lane], reduction[localQuery][lane + stride]);
                }
                barrier();
            }
            blockMaximum = reduction[localQuery][0];
        }
        precise float nextMaximum = max(maximum, blockMaximum);
        precise float alpha = isinf(maximum) ? 0.0 : exp(maximum - nextMaximum);
        precise float weight = allowed ? exp(score - nextMaximum) : 0.0;
        if (!useSubgroups || gl_SubgroupSize != 64) {
            barrier();
        }
        scores[localQuery][lane] = weight;
        precise float blockSum = 0.0;
        if (useSubgroups && gl_SubgroupSize == 64) {
            blockSum = subgroupAdd(weight);
            barrier();
        } else if (useSubgroups) {
            precise float sumPart = subgroupAdd(weight);
            if (subgroupElect()) {
                subgroupValues[gl_SubgroupID] = sumPart;
            }
            barrier();
            for (uint groupIndex = 0; groupIndex < gl_NumSubgroups; ++groupIndex) {
                if (subgroupRows[groupIndex] == localQuery) {
                    blockSum = blockSum + subgroupValues[groupIndex];
                }
            }
        } else {
            reduction[localQuery][lane] = weight;
            barrier();
            for (uint stride = 32; stride > 0; stride >>= 1) {
                if (lane < stride) {
                    precise float combined = reduction[localQuery][lane] + reduction[localQuery][lane + stride];
                    reduction[localQuery][lane] = combined;
                }
                barrier();
            }
            blockSum = reduction[localQuery][0];
        }
        precise float scaledDenominator = denominator * alpha;
        denominator = scaledDenominator + blockSum;
        precise float accumulated = accumulator * alpha;
        for (uint localKey = 0; localKey < min(64u, keyCount - first); ++localKey) {
            precise float product = scores[localQuery][localKey] * tileV[localKey][lane];
            accumulated = accumulated + product;
        }
        accumulator = accumulated;
        maximum = nextMaximum;
        // 全组完成PV后才允许覆盖下一块K/V，尾query同样参加同步
        barrier();
    }
    if (validQuery) {
        result.values[outputOffset + lane] = denominator > 0.0 ? accumulator / denominator : 0.0;
    }
}
