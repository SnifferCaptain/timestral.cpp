# glslc的版本输出也会列出glslang依赖，必须优先识别shaderc/glslc自身
function(timestralVulkanCompilerKind TEXT RESULT)
    if("${TEXT}" MATCHES "shaderc|glslc")
        set(${RESULT} GLSLC PARENT_SCOPE)
    elseif("${TEXT}" MATCHES "[Gg]lslang")
        set(${RESULT} GLSLANGVALIDATOR PARENT_SCOPE)
    else()
        set(${RESULT} "" PARENT_SCOPE)
    endif()
endfunction()

# 自动探测不回写用户覆盖项，切换KIND时不会复用上一次自动选择
set(TIMESTRAL_VULKAN_SHADER_COMPILER "" CACHE FILEPATH "显式指定glslc或glslangValidator，空值时自动探测")
set(TIMESTRAL_VULKAN_SHADER_COMPILER_KIND "AUTO" CACHE STRING "AUTO、GLSLC或GLSLANGVALIDATOR")
set_property(CACHE TIMESTRAL_VULKAN_SHADER_COMPILER_KIND PROPERTY STRINGS AUTO GLSLC GLSLANGVALIDATOR)
if(NOT TIMESTRAL_VULKAN_SHADER_COMPILER_KIND MATCHES "^(AUTO|GLSLC|GLSLANGVALIDATOR)$")
    message(FATAL_ERROR "TIMESTRAL_VULKAN_SHADER_COMPILER_KIND必须是AUTO、GLSLC或GLSLANGVALIDATOR")
endif()
set(TIMESTRAL_VULKAN_SELECTED_KIND "${TIMESTRAL_VULKAN_SHADER_COMPILER_KIND}")
if(TIMESTRAL_VULKAN_SHADER_COMPILER)
    if(NOT EXISTS "${TIMESTRAL_VULKAN_SHADER_COMPILER}" OR IS_DIRECTORY "${TIMESTRAL_VULKAN_SHADER_COMPILER}")
        message(FATAL_ERROR "显式Vulkan shader编译器不存在: ${TIMESTRAL_VULKAN_SHADER_COMPILER}")
    endif()
    set(TIMESTRAL_VULKAN_SELECTED_COMPILER "${TIMESTRAL_VULKAN_SHADER_COMPILER}")
    if(TIMESTRAL_VULKAN_SELECTED_KIND STREQUAL "AUTO")
        get_filename_component(COMPILER_NAME "${TIMESTRAL_VULKAN_SELECTED_COMPILER}" NAME_WE)
        string(TOLOWER "${COMPILER_NAME}" COMPILER_NAME)
        if(COMPILER_NAME STREQUAL "glslc")
            set(TIMESTRAL_VULKAN_SELECTED_KIND GLSLC)
        elseif(COMPILER_NAME MATCHES "^glslang(validator)?$")
            set(TIMESTRAL_VULKAN_SELECTED_KIND GLSLANGVALIDATOR)
        else()
            execute_process(COMMAND "${TIMESTRAL_VULKAN_SELECTED_COMPILER}" --version
                RESULT_VARIABLE VERSION_RESULT OUTPUT_VARIABLE VERSION_TEXT ERROR_VARIABLE VERSION_ERROR)
            set(DETECTED_KIND "")
            if(VERSION_RESULT EQUAL 0)
                timestralVulkanCompilerKind("${VERSION_TEXT}${VERSION_ERROR}" DETECTED_KIND)
            endif()
            if(DETECTED_KIND)
                set(TIMESTRAL_VULKAN_SELECTED_KIND "${DETECTED_KIND}")
            else()
                message(FATAL_ERROR "不能识别shader编译器，请显式设置TIMESTRAL_VULKAN_SHADER_COMPILER_KIND")
            endif()
        endif()
    endif()
else()
    if(NOT TIMESTRAL_VULKAN_SELECTED_KIND STREQUAL "GLSLANGVALIDATOR")
        find_program(TIMESTRAL_VULKAN_GLSLC NAMES glslc
            HINTS "${Vulkan_INCLUDE_DIR}/../Bin" "${Vulkan_INCLUDE_DIR}/../bin" "$ENV{VULKAN_SDK}/Bin")
    endif()
    if(TIMESTRAL_VULKAN_GLSLC AND NOT TIMESTRAL_VULKAN_SELECTED_KIND STREQUAL "GLSLANGVALIDATOR")
        set(TIMESTRAL_VULKAN_SELECTED_COMPILER "${TIMESTRAL_VULKAN_GLSLC}")
        set(TIMESTRAL_VULKAN_SELECTED_KIND GLSLC)
    else()
        if(NOT TIMESTRAL_VULKAN_SELECTED_KIND STREQUAL "GLSLC")
            find_program(TIMESTRAL_VULKAN_GLSLANG_VALIDATOR NAMES glslangValidator glslang
                HINTS "${Vulkan_INCLUDE_DIR}/../Bin" "${Vulkan_INCLUDE_DIR}/../bin" "$ENV{VULKAN_SDK}/Bin")
        endif()
        if(TIMESTRAL_VULKAN_GLSLANG_VALIDATOR AND NOT TIMESTRAL_VULKAN_SELECTED_KIND STREQUAL "GLSLC")
            set(TIMESTRAL_VULKAN_SELECTED_COMPILER "${TIMESTRAL_VULKAN_GLSLANG_VALIDATOR}")
            set(TIMESTRAL_VULKAN_SELECTED_KIND GLSLANGVALIDATOR)
        else()
            message(FATAL_ERROR "未找到要求的glslc/glslangValidator；可设置TIMESTRAL_VULKAN_SHADER_COMPILER或完整TIMESTRAL_VULKAN_SPV_DIR")
        endif()
    endif()
endif()
if(TIMESTRAL_VULKAN_SELECTED_KIND STREQUAL "GLSLC")
    set(TIMESTRAL_VULKAN_TARGET_FLAGS --target-env=vulkan1.1)
else()
    set(TIMESTRAL_VULKAN_TARGET_FLAGS -V --target-env vulkan1.1)
endif()
message(STATUS "Vulkan shader compiler: ${TIMESTRAL_VULKAN_SELECTED_COMPILER} (${TIMESTRAL_VULKAN_SELECTED_KIND})")
